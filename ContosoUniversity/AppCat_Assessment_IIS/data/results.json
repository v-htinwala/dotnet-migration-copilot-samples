    "COM.0001": {
      "id": "COM.0001",
      "description": "You application is using COM.\n\nOut-of-process COM usage does not work in Azure App Service and is an anti-pattern in Azure Kubernetes Service and Azure Container Apps. In-process COM will work, but it is not possible to register new COM classes.\n\nConsider the following alternatives:\n\n    1. Review application architecture to see if the COM dependency can be removed. For example, Office COM dependencies might be replaceable with OpenXML packages which allow reading and writing Office files.\n    2. See whether registration-free COM is an option. Registration-free COM is supported for .NET 6\u002B apps running in Azure App Service.\n    3. Consider running the application in a container so that COM can be used. Azure App Service can host containerized apps.\n    4. Consider running the application in a VM.",
      "label": "COM usage detected",
      "severity": "Mandatory",
      "effort": 5,
      "links": [
        {
          "url": "https://go.microsoft.com/fwlink/?linkid=2243263"
        }
      ]
    },
    "Database.0003": {
      "id": "Database.0003",
      "description": "System.Data.SqlClient dependency is detected.\n\nWhile System.Data.SqlClient will work in Azure, the newer Microsoft.Data.SqlClient package is the primary .NET SQL client moving forward and receiving the latest features. For example, Microsoft.Data.SqlClient easily allows use of Azure Managed Identity from a connection string.",
      "label": "System.Data.SqlClient dependency detected",
      "severity": "Optional",
      "effort": 3,
      "links": [
        {
          "url": "https://go.microsoft.com/fwlink/?LinkID=2242668"
        }
      ]
    },
    "Identity.0002": {
      "id": "Identity.0002",
      "description": "Your app is using windows authentication which is not supported on Azure App Service, Azure Container Apps and Azure Kubernetes Service.\n\nAzure App Service provides built-in authentication and authorization capabilities, so you can sign in users and access data by writing minimal or no code in your web app.\n\nFollow the link below for more information.\u0022",
      "label": "Windows authentication detected",
      "severity": "Mandatory",
      "effort": 3,
      "links": [
