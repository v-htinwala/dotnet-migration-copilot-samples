@model Exception

@{
    ViewBag.Title = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model != null)
{
    <p>
        <strong>Exception Details:</strong> @Model.Message
    </p>
    <p>
        <strong>Stack Trace:</strong>
        <pre>@Model.StackTrace</pre>
    </p>
}
