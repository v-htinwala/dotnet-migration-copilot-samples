# Example terraform.tfvars file
# terraform.tfvars.example
# This file shows the optional secrets you can configure
# Most secrets are now AUTO-GENERATED or stored in Key Vault!
#
# SQL Password: AUTO-GENERATED by Terraform (see random-password.tf)
# - No need to provide sql_admin_password
# - It's automatically created and stored in Key Vault
#
# For non-secret configuration, see dev.tfvars (or prod.tfvars, staging.tfvars)

# =============================================================================
# OPTIONAL: Microsoft Entra ID Authentication Secrets
# Only needed if enable_entra_id_auth = true in dev.tfvars
# =============================================================================

# Get these from Azure Portal ? Microsoft Entra ID ? App registrations
# entra_client_id     = "your-application-client-id"
# entra_tenant_id     = "your-directory-tenant-id"
# entra_client_secret = "your-client-secret"

# =============================================================================
# NOTES
# =============================================================================
# 1. SQL password is now AUTO-GENERATED - you don't need to create this file!
# 2. The auto-generated password is stored in Azure Key Vault
# 3. Only add this file if you need Entra ID authentication
# 4. For environment config (non-secrets), edit dev.tfvars instead
# 5. Deploy with: terraform apply -var-file=dev.tfvars

